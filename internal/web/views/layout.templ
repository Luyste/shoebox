package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html>
		<head>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/output.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

templ Page(cards []Media) {
	@Layout("Photos") {
		@Grid(cards)
	}
}
